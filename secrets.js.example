// Finance tab watchlist — the assets shown the first time the tab is opened.
// After that the list is editable in the dashboard and persists to
// ~/.local/state/quickshell/by-shell/<id>/finance.json, which takes precedence.
// Any Yahoo Finance symbol works: stocks (AAPL), crypto (BTC-USD),
// FX (EURUSD=X), indices (^GSPC). Leave empty to fall back to a built-in default.
const financeSymbols = ["AAPL", "BTC-USD", "EURUSD=X", "^GSPC", "NVDA"]
